# Development PostgreSQL
POSTGRES_DB=solar_data
POSTGRES_USER=solar_user
POSTGRES_PASSWORD=solar_password
POSTGRES_PORT=5433

# Test PostgreSQL
POSTGRES_TEST_DB=solar_data_test
POSTGRES_TEST_USER=solar_test_user
POSTGRES_TEST_PASSWORD=solar_test_password
POSTGRES_TEST_PORT=5434

# Application connection used by src/database.py and dbt.
DATABASE_URL=postgresql://solar_user:solar_password@localhost:5433/solar_data

# Isolated connection used by pytest integration tests.
# tests/conftest.py validates this target before redirecting DATABASE_URL.
TEST_DATABASE_URL=postgresql://solar_test_user:solar_test_password@localhost:5434/solar_data_test

# Airflow local development
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_API_PORT=8080

# On Linux, set this to the output of: id -u
# On Windows/Docker Desktop the default 50000 is usually sufficient.
AIRFLOW_UID=50000

# Development-only example values. Replace them in .env before using
# this setup outside an isolated local environment.
AIRFLOW_FERNET_KEY=Oo6MKcTIpSdfdpwFtvvNb5tBFpqeHWx2IN7vsEWg00s=
AIRFLOW_API_SECRET_KEY=1svmkDNvwWPi4iT3YvVrccEefqbteddfHw_l4iUO7yQ
