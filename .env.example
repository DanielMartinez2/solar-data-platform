# Development PostgreSQL
POSTGRES_DB=solar_data
POSTGRES_USER=solar_user
POSTGRES_PASSWORD=solar_password
POSTGRES_PORT=5433

# Test PostgreSQL
POSTGRES_TEST_DB=solar_data_test
POSTGRES_TEST_USER=solar_test_user
POSTGRES_TEST_PASSWORD=solar_test_password
POSTGRES_TEST_PORT=5434

# Connection used by src/database.py and by database integration tests.
# Default local development connection:
DATABASE_URL=postgresql://solar_user:solar_password@localhost:5433/solar_data

# When running database integration tests locally, override DATABASE_URL
# so the tests use the isolated test database:
# DATABASE_URL=postgresql://solar_test_user:solar_test_password@localhost:5434/solar_data_test
