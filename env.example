# Exemplo para ambiente de desenvolvimento local.
# Copie para .env e substitua a senha; nunca versione o .env.
POSTGRES_DB=solar_data
POSTGRES_USER=solar_user
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5433

# Python roda no host (fora do Docker).
# Mantenha usuario, senha, banco e porta sincronizados com as variaveis acima.
DATABASE_URL=postgresql://solar_user:troque_esta_senha@localhost:5433/solar_data
